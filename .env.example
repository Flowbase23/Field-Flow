# ─── FieldFlow environment variables ─────────────────────────────────────────────
# Copy to .env.local (development) and fill in real values. NEVER commit .env*.
#
# NOTE: DATABASE_URL targets the provisioned Neon Postgres for this workspace
# (the initial migration is applied there). Clerk keys are NOT configured yet,
# so live auth/webhook flows remain PENDING LIVE VERIFICATION. These example
# values are placeholders; nothing here is a real credential.

# PostgreSQL connection string used by Prisma (design: single Postgres, shared
# tables, organizationId on every tenant model). Required for any DB command.
DATABASE_URL="postgresql://user:password@localhost:5432/fieldflow?schema=public"

# Clerk — Dashboard → API Keys → Publishable key.
# Required by the browser bundle (ClerkProvider, SignIn/SignUp, UserButton) at runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Clerk — Dashboard → API Keys → Secret key.
# Required server-side by @clerk/nextjs (auth(), clerkMiddleware) at runtime.
CLERK_SECRET_KEY=sk_test_xxxx

# Clerk webhook signing secret — Dashboard → Webhooks → your endpoint → Signing secret.
# Used by src/app/api/webhooks/clerk/route.ts to verify svix signatures.
# The endpoint URL should be: https://<your-app>/api/webhooks/clerk
# Enabled events: user.created/updated/deleted, organization.created/updated/deleted,
# organizationMembership.created/updated/deleted.
CLERK_WEBHOOK_SECRET=whsec_xxxx

# ─── Optional ─────────────────────────────────────────────────────────────────────
# Seed guard: prisma/seed.ts refuses to run without this set.
SEED_RUN=1
